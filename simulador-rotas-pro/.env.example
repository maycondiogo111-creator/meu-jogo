# ============================================
# Simulador de Rotas Pro - Configuracao
# ============================================
# Copie este arquivo para .env e preencha os valores.
# cp .env.example .env

# -- API OpenRouteService (obrigatorio) --------
# Obtenha sua chave em: https://openrouteservice.org/dev/#/signup
ORS_API_KEY=COLE_SUA_CHAVE_AQUI

# Limite de requisicoes por hora (protecao de custo)
ORS_MAX_REQUESTS_POR_HORA=40

# -- Custos Operacionais -----------------------
CUSTO_KM=2.5
CUSTO_MIN=0.8

# -- Flask -------------------------------------
FLASK_DEBUG=true
PORT=5000
